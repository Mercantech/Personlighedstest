# Dokploy / docker compose for https://16.mercantec.tech
# Kopiér til .env og sæt stærke secrets i produktion.

POSTGRES_USER=samspil
POSTGRES_PASSWORD=samspil
POSTGRES_DB=samspil
DATABASE_URL=postgres://samspil:samspil@db:5432/samspil

HOST=0.0.0.0
API_PORT=3001

AUTH_ISSUER=https://auth.mercantec.tech
AUTH_AUDIENCE=mercantec-apps
JWKS_URI=https://auth.mercantec.tech/.well-known/jwks.json
CORS_ORIGIN=https://16.mercantec.tech

ADMIN_ROLES=admin
# ADMIN_ALLOWLIST=

VITE_API_BASE_URL=/api
VITE_AUTH_CLIENT_ID=samspil
VITE_ADMIN_ROLES=admin
# VITE_ADMIN_ALLOWLIST=
